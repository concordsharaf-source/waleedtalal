{
  "headers": [
    {
      "source": "/pages/track.html",
      "headers": [
        { "key": "Accept-CH", "value": "Sec-CH-UA-Model, Sec-CH-UA-Platform-Version, Sec-CH-UA-Arch, Sec-CH-UA-Bitness, Sec-CH-UA-Mobile, Sec-CH-UA-Platform" },
        { "key": "Critical-CH", "value": "Sec-CH-UA-Model, Sec-CH-UA-Platform-Version" },
        { "key": "Permissions-Policy", "value": "ch-ua-model=(self), ch-ua-platform-version=(self), ch-ua-arch=(self), ch-ua-bitness=(self)" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "CDN-Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
